{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoE training record",
  "type": "object",
  "required": ["feature_version", "label", "features"],
  "properties": {
    "feature_version": {"const": "2.0"},
    "label": {
      "enum": [
        "likely_human_driven_activity",
        "possible_automation",
        "inconclusive"
      ]
    },
    "features": {
      "type": "array",
      "items": {"type": "number"}
    },
    "source_session_id": {"type": "string"},
    "synthetic": {"type": "boolean"}
  },
  "additionalProperties": false
}

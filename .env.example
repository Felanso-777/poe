# .env.example — Proof of Effort root configuration
# Copy to .env and fill in your values.  This file is safe to commit.

# Hardhat local node (default)
POE_RPC_URL=http://127.0.0.1:8545
POE_CHAIN_ID=31337

# Contract deployed address (updated automatically by blockchain_manager.py)
POE_CONTRACT_ADDRESS=0xREPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# Hardhat test account private key — NEVER use a real key here
POE_PRIVATE_KEY=0xREPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS_PRIVATE_KEY

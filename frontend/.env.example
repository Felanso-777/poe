# .env.example — copy to .env and fill in your values
# This file is safe to commit.  .env is git-ignored.

# Hardhat local node (default)
VITE_POE_RPC_URL=http://127.0.0.1:8545

# Contract deployed address (shown after: cd blockchain && npx hardhat run scripts/deploy.js --network hardhat)
# Copy the printed address here after deployment.
VITE_POE_CONTRACT_ADDRESS=0xREPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# Hardhat local chain ID
VITE_POE_CHAIN_ID=31337

# Set to "true" to enable demo mode with clearly-labeled mock data.
# Demo mode requires NO blockchain connection and NO private key.
VITE_DEMO_MODE=false

# Supabase (Auth)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-public-key
